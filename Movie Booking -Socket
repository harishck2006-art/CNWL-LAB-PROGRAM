void viewMovies(char *response) {
    char temp[512];
    int i, j;

    strcpy(response, "\n");
    strcat(response, "==============================================\n");
    strcat(response, "          NOW SHOWING MOVIES                  \n");
    strcat(response, "==============================================\n\n");

    for (i = 0; i < movieCount; i++) {
        sprintf(temp, "  Movie ID : %d\n", movies[i].movieId);
        strcat(response, temp);
        sprintf(temp, "  Name     : %s\n", movies[i].name);
        strcat(response, temp);
        sprintf(temp, "  Language : %s\n", movies[i].language);
        strcat(response, temp);
        strcat(response, "  Shows:\n");

        for (j = 0; j < movies[i].showCount; j++) {
            sprintf(temp, "    Show %d | Time: %-10s | Seats: %2d | Rs.%.0f\n",
                    movies[i].shows[j].showId,
                    movies[i].shows[j].time,
                    movies[i].shows[j].availableSeats,
                    movies[i].shows[j].price);
            strcat(response, temp);
        }
        strcat(response, "----------------------------------------------\n");
    }
}

void checkAvailability(int movieId, int showId, char *response) {
    Movie *m;
    Show *s;

    if (movieId < 1 || movieId > movieCount) {
        strcpy(response, "\n[ERROR] Invalid Movie ID!\n");
        return;
    }
    m = &movies[movieId - 1];
    if (showId < 1 || showId > m->showCount) {
        strcpy(response, "\n[ERROR] Invalid Show ID!\n");
        return;
    }
    s = &m->shows[showId - 1];

    sprintf(response,
            "\n==============================================\n"
            "          SEAT AVAILABILITY                   \n"
            "==============================================\n"
            "  Movie    : %s\n"
            "  Show     : %d | Time: %s\n"
            "  Available: %d / %d seats\n"
            "  Price    : Rs.%.0f per ticket\n"
            "==============================================\n",
            m->name, s->showId, s->time,
            s->availableSeats, MAX_SEATS, s->price);
}

void bookTickets(int movieId, int showId, char *customerName,
                 int numTickets, char *response) {
    Movie *m;
    Show *s;
    Booking *b;

    if (movieId < 1 || movieId > movieCount) {
        strcpy(response, "\n[ERROR] Invalid Movie ID!\n");
        return;
    }
    m = &movies[movieId - 1];
    if (showId < 1 || showId > m->showCount) {
        strcpy(response, "\n[ERROR] Invalid Show ID!\n");
        return;
    }
    s = &m->shows[showId - 1];
    if (numTickets <= 0) {
        strcpy(response, "\n[ERROR] Tickets must be >= 1!\n");
        return;
    }
    if (numTickets > s->availableSeats) {
        sprintf(response, "\n[ERROR] Only %d seats available!\n",
                s->availableSeats);
        return;
    }
    if (bookingCount >= MAX_BOOKINGS) {
        strcpy(response, "\n[ERROR] Booking system full!\n");
        return;
    }

    s->availableSeats -= numTickets;

    b = &bookings[bookingCount];
    b->bookingId = nextBookingId++;
    b->movieId = movieId;
    b->showId = showId;
    strcpy(b->customerName, customerName);
    b->numTickets = numTickets;
    b->totalPrice = numTickets * s->price;
    b->active = 1;
    bookingCount++;

    sprintf(response,
            "\n==============================================\n"
            "        BOOKING CONFIRMED!                    \n"
            "==============================================\n"
            "  Booking ID : %d\n"
            "  Customer   : %s\n"
            "  Movie      : %s\n"
            "  Show       : %d | Time: %s\n"
            "  Tickets    : %d\n"
            "  Total Price: Rs.%.0f\n"
            "  Remaining  : %d seats\n"
            "==============================================\n",
            b->bookingId, b->customerName, m->name,
            s->showId, s->time, b->numTickets,
            b->totalPrice, s->availableSeats);

    printf("[SERVER] Booking #%d - %s booked %d for %s\n",
           b->bookingId, customerName, numTickets, m->name);
}

void cancelBooking(int bookingId, char *response) {
    int i;
    Movie *m;
    Show *s;

    for (i = 0; i < bookingCount; i++) {
        if (bookings[i].bookingId == bookingId) {
            if (!bookings[i].active) {
                strcpy(response, "\n[ERROR] Already cancelled!\n");
                return;
            }
            m = &movies[bookings[i].movieId - 1];
            s = &m->shows[bookings[i].showId - 1];
            s->availableSeats += bookings[i].numTickets;
            bookings[i].active = 0;

            sprintf(response,
                    "\n==============================================\n"
                    "       BOOKING CANCELLED!                     \n"
                    "==============================================\n"
                    "  Booking ID : %d\n"
                    "  Customer   : %s\n"
                    "  Movie      : %s\n"
                    "  Refund     : Rs.%.0f\n"
                    "  Seats Now  : %d available\n"
                    "==============================================\n",
                    bookings[i].bookingId, bookings[i].customerName,
                    m->name, bookings[i].totalPrice,
                    s->availableSeats);

            printf("[SERVER] Booking #%d cancelled\n", bookingId);
            return;
        }
    }
    strcpy(response, "\n[ERROR] Booking ID not found!\n");
}

void displayBooking(int bookingId, char *response) {
    int i;
    Movie *m;
    Show *s;

    for (i = 0; i < bookingCount; i++) {
        if (bookings[i].bookingId == bookingId) {
            m = &movies[bookings[i].movieId - 1];
            s = &m->shows[bookings[i].showId - 1];

            sprintf(response,
                    "\n==============================================\n"
                    "            BOOKING DETAILS                   \n"
                    "==============================================\n"
                    "  Booking ID : %d\n"
                    "  Status     : %s\n"
                    "  Customer   : %s\n"
                    "  Movie      : %s (%s)\n"
                    "  Show       : %d | Time: %s\n"
                    "  Tickets    : %d\n"
                    "  Total      : Rs.%.0f\n"
                    "==============================================\n",
                    bookings[i].bookingId,
                    bookings[i].active ? "CONFIRMED" : "CANCELLED",
                    bookings[i].customerName,
                    m->name, m->language,
                    s->showId, s->time,
                    bookings[i].numTickets,
                    bookings[i].totalPrice);
            return;
        }
    }
    strcpy(response, "\n[ERROR] Booking ID not found!\n");
}

void processRequest(char *request, char *response) {
    int choice;
    sscanf(request, "%d", &choice);

    switch (choice) {
        case 1:
            viewMovies(response);
            break;
        case 2: {
            int mid, sid;
            sscanf(request, "%d %d %d", &choice, &mid, &sid);
            checkAvailability(mid, sid, response);
            break;
        }
        case 3: {
            int mid, sid, n;
            char name[100];
            sscanf(request, "%d %d %d %s %d", &choice, &mid, &sid, name, &n);
            bookTickets(mid, sid, name, n, response);
            break;
        }
        case 4: {
            int bid;
            sscanf(request, "%d %d", &choice, &bid);
            cancelBooking(bid, response);
            break;
        }
        case 5: {
            int bid;
            sscanf(request, "%d %d", &choice, &bid);
            displayBooking(bid, response);
            break;
        }
        case 6:
            strcpy(response, "\nGoodbye! Thank you!\n");
            break;
        default:
            strcpy(response, "\n[ERROR] Invalid option!\n");
            break;
    }
}

int main() {
    int serverFd, clientFd;
    struct sockaddr_in serverAddr, clientAddr;
    socklen_t clientLen;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    int opt = 1;
    int n, ch;

    initializeMovies();

    serverFd = socket(AF_INET, SOCK_STREAM, 0);
    if (serverFd < 0) {
        perror("Socket failed");
        exit(1);
    }

    setsockopt(serverFd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_addr.s_addr = INADDR_ANY;
    serverAddr.sin_port = htons(PORT);

    if (bind(serverFd, (struct sockaddr *)&serverAddr, sizeof(serverAddr)) < 0) {
        perror("Bind failed");
        close(serverFd);
        exit(1);
    }

    if (listen(serverFd, 5) < 0) {
        perror("Listen failed");
        close(serverFd);
        exit(1);
    }

    printf("==============================================\n");
    printf("   MOVIE BOOKING SERVER STARTED               \n");
    printf("   Port: %d                                   \n", PORT);
    printf("==============================================\n\n");

    while (1) {
        clientLen = sizeof(clientAddr);
        clientFd = accept(serverFd, (struct sockaddr *)&clientAddr, &clientLen);

        if (clientFd < 0) {
            perror("Accept failed");
            continue;
        }

        printf("[SERVER] Client connected: %s:%d\n",
               inet_ntoa(clientAddr.sin_addr), ntohs(clientAddr.sin_port));

        while (1) {
            memset(buffer, 0, BUFFER_SIZE);
            memset(response, 0, BUFFER_SIZE);

            n = read(clientFd, buffer, BUFFER_SIZE - 1);
            if (n <= 0) {
                printf("[SERVER] Client disconnected.\n\n");
                break;
            }
            buffer[n] = '\0';
            printf("[SERVER] Request: %s\n", buffer);

            processRequest(buffer, response);

            write(clientFd, response, strlen(response));

            sscanf(buffer, "%d", &ch);
            if (ch == 6) {
                printf("[SERVER] Client exited.\n\n");
                break;
            }
        }
        close(clientFd);
    }

    close(serverFd);
    return 0;
}
