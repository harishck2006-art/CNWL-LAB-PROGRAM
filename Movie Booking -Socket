#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8080
#define BUFFER_SIZE 4096
#define SERVER_IP "127.0.0.1"

void displayMenu() {
    printf("\n");
    printf("==============================================\n");
    printf("      MOVIE TICKET BOOKING SYSTEM             \n");
    printf("==============================================\n");
    printf("  1. View Movie List\n");
    printf("  2. Check Seat Availability\n");
    printf("  3. Book Tickets\n");
    printf("  4. Cancel Booking\n");
    printf("  5. Display Booking Details\n");
    printf("  6. Exit\n");
    printf("==============================================\n");
    printf("  Enter your choice: ");
}

int main() {
    int sockFd;
    struct sockaddr_in serverAddr;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    int choice, n;
    int mid, sid, num, bid;
    char name[100];

    sockFd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockFd < 0) {
        perror("Socket failed");
        exit(1);
    }

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_port = htons(PORT);
    inet_pton(AF_INET, SERVER_IP, &serverAddr.sin_addr);

    if (connect(sockFd, (struct sockaddr *)&serverAddr, sizeof(serverAddr)) < 0) {
        perror("Connection failed. Is server running?");
        close(sockFd);
        exit(1);
    }

    printf("\n==============================================\n");
    printf("   Connected to Movie Booking Server!         \n");
    printf("==============================================\n");

    while (1) {
        displayMenu();
        scanf("%d", &choice);

        memset(buffer, 0, BUFFER_SIZE);
        memset(response, 0, BUFFER_SIZE);

        switch (choice) {
            case 1:
                sprintf(buffer, "1");
                break;
            case 2:
                printf("\n  Enter Movie ID: ");
                scanf("%d", &mid);
                printf("  Enter Show ID (1/2/3): ");
                scanf("%d", &sid);
                sprintf(buffer, "2 %d %d", mid, sid);
                break;
            case 3:
                printf("\n  Enter Movie ID: ");
                scanf("%d", &mid);
                printf("  Enter Show ID (1/2/3): ");
                scanf("%d", &sid);
                printf("  Enter Your Name: ");
                scanf("%s", name);
                printf("  Enter Number of Tickets: ");
                scanf("%d", &num);
                sprintf(buffer, "3 %d %d %s %d", mid, sid, name, num);
                break;
            case 4:
                printf("\n  Enter Booking ID to cancel: ");
                scanf("%d", &bid);
                sprintf(buffer, "4 %d", bid);
                break;
            case 5:
                printf("\n  Enter Booking ID: ");
                scanf("%d", &bid);
                sprintf(buffer, "5 %d", bid);
                break;
            case 6:
                sprintf(buffer, "6");
                write(sockFd, buffer, strlen(buffer));
                memset(response, 0, BUFFER_SIZE);
                read(sockFd, response, BUFFER_SIZE - 1);
                printf("%s", response);
                printf("\nGoodbye!\n\n");
                close(sockFd);
                return 0;
            default:
                printf("\n[ERROR] Invalid choice!\n");
                continue;
        }

        write(sockFd, buffer, strlen(buffer));

        memset(response, 0, BUFFER_SIZE);
        n = read(sockFd, response, BUFFER_SIZE - 1);
        if (n <= 0) {
            printf("\n[ERROR] Server disconnected!\n");
            break;
        }
        response[n] = '\0';
        printf("%s", response);
    }

    close(sockFd);
    return 0;
}
