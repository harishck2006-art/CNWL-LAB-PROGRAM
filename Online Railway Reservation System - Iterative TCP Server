    /* Find train name */
    tr = NULL;
    for (i = 0; i < trainCount; i++) {
        if (trains[i].trainId == bookings[found].trainId) {
            tr = &trains[i];
            break;
        }
    }

    sprintf(response,
            "\n================================================================\n"
            "              PNR STATUS                                       \n"
            "================================================================\n"
            "  PNR Number   : %d\n"
            "  Status       : %s\n"
            "  Passenger    : %s (Age: %d, %s)\n"
            "  Train        : %d - %s\n"
            "  Route        : %s -> %s\n"
            "  Journey Date : %s\n"
            "  Tickets      : %d\n"
            "  Total Fare   : Rs.%.0f\n"
            "  Booked At    : %s\n"
            "================================================================\n",
            bookings[found].pnr,
            bookings[found].status,
            bookings[found].passengerName,
            bookings[found].age,
            bookings[found].gender,
            bookings[found].trainId,
            tr ? tr->trainName : "Unknown",
            tr ? tr->source : "?",
            tr ? tr->destination : "?",
            bookings[found].journeyDate,
            bookings[found].numTickets,
            bookings[found].totalFare,
            bookings[found].bookingTime);
}

/* ================== PROCESS REQUEST ================== */

void processRequest(char *request, char *response,
                    const char *clientIP, int clientPort) {
    int choice;
    char logMsg[256];

    sscanf(request, "%d", &choice);

    switch (choice) {
        case 1: {
            /* Search trains by route */
            char src[40], dest[40];
            sscanf(request, "%d %s %s", &choice, src, dest);
            sprintf(logMsg, "Search: %s -> %s", src, dest);
            writeLog(clientIP, clientPort, logMsg);
            searchTrains(src, dest, response);
            break;
        }
        case 2: {
            /* List all trains */
            writeLog(clientIP, clientPort, "List all trains");
            listAllTrains(response);
            break;
        }
        case 3: {
            /* Check seat availability */
            int tid, cid;
            sscanf(request, "%d %d %d", &choice, &tid, &cid);
            sprintf(logMsg, "Check availability: Train %d Class %d", tid, cid);
            writeLog(clientIP, clientPort, logMsg);
            checkAvailability(tid, cid, response);
            break;
        }
        case 4: {
            /* Book ticket */
            int tid, cid, age, num;
            char name[100], gender[10], jdate[20];
            sscanf(request, "%d %d %d %s %d %s %d %s",
                   &choice, &tid, &cid, name, &age,
                   gender, &num, jdate);
            sprintf(logMsg, "Book: %s Train-%d Class-%d x%d",
                    name, tid, cid, num);
            writeLog(clientIP, clientPort, logMsg);
            bookTicket(tid, cid, name, age, gender, num, jdate, response);
            break;
        }
        case 5: {
            /* Cancel reservation */
            int pnr;
            sscanf(request, "%d %d", &choice, &pnr);
            sprintf(logMsg, "Cancel PNR: %d", pnr);
            writeLog(clientIP, clientPort, logMsg);
            cancelReservation(pnr, response);
            break;
        }
        case 6: {
            /* View booking status */
            int pnr;
            sscanf(request, "%d %d", &choice, &pnr);
            sprintf(logMsg, "PNR Status: %d", pnr);
            writeLog(clientIP, clientPort, logMsg);
            viewBookingStatus(pnr, response);
            break;
        }
        case 7: {
            writeLog(clientIP, clientPort, "Client exiting");
            strcpy(response,
                   "\n  Thank you for using Railway Reservation!\n"
                   "  Have a safe journey!\n");
            break;
        }
        default:
            strcpy(response, "\n[ERROR] Invalid option! Choose 1-7.\n");
            break;
    }
}

/* ================== MAIN SERVER ================== */

int main() {
    int serverFd, clientFd;
    struct sockaddr_in serverAddr, clientAddr;
    socklen_t clientLen;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    int opt = 1;
    int n, ch;
    char clientIP[INET_ADDRSTRLEN];
    int clientPort;
    char logMsg[256];

    /* Initialize */
    initializeTrains();
    saveDatabase();

    /* Create socket */
    serverFd = socket(AF_INET, SOCK_STREAM, 0);
    if (serverFd < 0) {
        perror("Socket failed");
        exit(1);
    }

    setsockopt(serverFd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_addr.s_addr = INADDR_ANY;
    serverAddr.sin_port = htons(PORT);

    if (bind(serverFd, (struct sockaddr *)&serverAddr,
             sizeof(serverAddr)) < 0) {
        perror("Bind failed");
        close(serverFd);
        exit(1);
    }

    if (listen(serverFd, 5) < 0) {
        perror("Listen failed");
        close(serverFd);
        exit(1);
    }

    printf("================================================================\n");
    printf("     ONLINE RAILWAY RESERVATION SERVER (ITERATIVE)             \n");
    printf("     Port: %d | Mode: One client at a time                     \n", PORT);
    printf("     Log: %s | DB: %s                                          \n",
           LOG_FILE, DB_FILE);
    printf("     Trains: %d loaded                                         \n", trainCount);
    printf("================================================================\n\n");

    writeLog(NULL, 0, "Server started - ITERATIVE mode");

    /* ---- ITERATIVE: One client at a time ---- */
    while (1) {
        clientLen = sizeof(clientAddr);

        printf("[SERVER] Waiting for next client...\n");

        clientFd = accept(serverFd,
                          (struct sockaddr *)&clientAddr,
                          &clientLen);

        if (clientFd < 0) {
            perror("Accept failed");
            continue;
        }

        strcpy(clientIP, inet_ntoa(clientAddr.sin_addr));
        clientPort = ntohs(clientAddr.sin_port);

        sprintf(logMsg, "Client connected");
        writeLog(clientIP, clientPort, logMsg);

        /* Handle this ONE client completely */
        while (1) {
            memset(buffer, 0, BUFFER_SIZE);
            memset(response, 0, BUFFER_SIZE);

            n = read(clientFd, buffer, BUFFER_SIZE - 1);
            if (n <= 0) {
                sprintf(logMsg, "Client disconnected");
                writeLog(clientIP, clientPort, logMsg);
                break;
            }
            buffer[n] = '\0';

            processRequest(buffer, response, clientIP, clientPort);

            write(clientFd, response, strlen(response));

            sscanf(buffer, "%d", &ch);
            if (ch == 7) {
                break;
            }
        }

        close(clientFd);
        printf("[SERVER] Client session ended. Ready for next.\n\n");
    }

    close(serverFd);
    return 0;
}
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8080
#define BUFFER_SIZE 4096
#define SERVER_IP "127.0.0.1"

void displayMenu() {
    printf("\n");
    printf("================================================================\n");
    printf("        ONLINE RAILWAY RESERVATION SYSTEM                      \n");
    printf("================================================================\n");
    printf("  1. Search Trains (by route)\n");
    printf("  2. View All Trains\n");
    printf("  3. Check Seat Availability\n");
    printf("  4. Book Ticket\n");
    printf("  5. Cancel Reservation\n");
    printf("  6. View Booking Status (PNR)\n");
    printf("  7. Exit\n");
    printf("================================================================\n");
    printf("  Enter your choice: ");
}

int main() {
    int sockFd;
    struct sockaddr_in serverAddr;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    int choice, n;
    int trainId, classId, age, numTickets, pnr;
    char name[100], gender[10], src[40], dest[40], jdate[20];

    sockFd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockFd < 0) {
        perror("Socket failed");
        exit(1);
    }

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_port = htons(PORT);
    inet_pton(AF_INET, SERVER_IP, &serverAddr.sin_addr);

    if (connect(sockFd, (struct sockaddr *)&serverAddr,
                sizeof(serverAddr)) < 0) {
        perror("Connection failed! Start the server first");
        close(sockFd);
        exit(1);
    }

    printf("\n================================================================\n");
    printf("   Connected to Railway Reservation Server!                    \n");
    printf("================================================================\n");

    while (1) {
        displayMenu();
        scanf("%d", &choice);

        memset(buffer, 0, BUFFER_SIZE);
        memset(response, 0, BUFFER_SIZE);

        switch (choice) {
            case 1:
                printf("\n  Enter Source Station: ");
                scanf("%s", src);
                printf("  Enter Destination Station: ");
                scanf("%s", dest);
                sprintf(buffer, "1 %s %s", src, dest);
                break;

            case 2:
                sprintf(buffer, "2");
                break;

            case 3:
                printf("\n  Enter Train ID: ");
                scanf("%d", &trainId);
                printf("  Enter Class ID (1/2/3): ");
                scanf("%d", &classId);
                sprintf(buffer, "3 %d %d", trainId, classId);
                break;

            case 4:
                printf("\n  ---- TICKET BOOKING ----\n");
                printf("  Enter Train ID: ");
                scanf("%d", &trainId);
                printf("  Enter Class ID (1/2/3): ");
                scanf("%d", &classId);
                printf("  Enter Passenger Name: ");
                scanf("%s", name);
                printf("  Enter Age: ");
                scanf("%d", &age);
                printf("  Enter Gender (Male/Female): ");
                scanf("%s", gender);
                printf("  Enter Number of Tickets (1-6): ");
                scanf("%d", &numTickets);
                printf("  Enter Journey Date (DD/MM/YYYY): ");
                scanf("%s", jdate);
                sprintf(buffer, "4 %d %d %s %d %s %d %s",
                        trainId, classId, name, age,
                        gender, numTickets, jdate);
                break;

            case 5:
                printf("\n  Enter PNR Number to cancel: ");
                scanf("%d", &pnr);
                sprintf(buffer, "5 %d", pnr);
                break;

            case 6:
                printf("\n  Enter PNR Number: ");
                scanf("%d", &pnr);
                sprintf(buffer, "6 %d", pnr);
                break;

            case 7:
                sprintf(buffer, "7");
                write(sockFd, buffer, strlen(buffer));
                memset(response, 0, BUFFER_SIZE);
                read(sockFd, response, BUFFER_SIZE - 1);
                printf("%s", response);
                printf("\nGoodbye!\n\n");
                close(sockFd);
                return 0;

            default:
                printf("\n[ERROR] Invalid choice! Choose 1-7.\n");
                continue;
        }

        /* Send */
        write(sockFd, buffer, strlen(buffer));

        /* Receive */
        memset(response, 0, BUFFER_SIZE);
        n = read(sockFd, response, BUFFER_SIZE - 1);
        if (n <= 0) {
            printf("\n[ERROR] Server disconnected!\n");
            break;
        }
        response[n] = '\0';
        printf("%s", response);
    }

    close(sockFd);
    return 0;
}
