/* ================== 3. CHECK SEAT AVAILABILITY ================== */

void checkAvailability(int trainId, int classId, char *response) {
    int i, j, tIdx, cIdx;
    Train *tr;
    TrainClass *cl;

    tIdx = -1;
    cIdx = -1;

    for (i = 0; i < trainCount; i++) {
        if (trains[i].trainId == trainId) {
            tIdx = i;
            break;
        }
    }

    if (tIdx == -1) {
        sprintf(response, "\n[ERROR] Train %d not found!\n", trainId);
        return;
    }

    tr = &trains[tIdx];

    for (j = 0; j < tr->classCount; j++) {
        if (tr->classes[j].classId == classId) {
            cIdx = j;
            break;
        }
    }

    if (cIdx == -1) {
        sprintf(response, "\n[ERROR] Class %d not available on Train %d!\n",
                classId, trainId);
        return;
    }

    cl = &tr->classes[cIdx];

    sprintf(response,
            "\n================================================================\n"
            "              SEAT AVAILABILITY                                \n"
            "================================================================\n"
            "  Train      : %d - %s\n"
            "  Route      : %s -> %s\n"
            "  Class      : %s\n"
            "  Total Seats: %d\n"
            "  Available  : %d\n"
            "  Booked     : %d\n"
            "  Fare/Ticket: Rs.%.0f\n"
            "================================================================\n",
            tr->trainId, tr->trainName,
            tr->source, tr->destination,
            cl->className,
            cl->totalSeats,
            cl->availableSeats,
            cl->totalSeats - cl->availableSeats,
            cl->fare);
}

/* ================== 4. BOOK TICKETS ================== */

void bookTicket(int trainId, int classId, char *name,
                int age, char *gender, int numTickets,
                char *journeyDate, char *response) {
    int i, j, tIdx, cIdx;
    Train *tr;
    TrainClass *cl;
    Booking *b;
    char logMsg[256];
    char ts[64];

    tIdx = -1;
    cIdx = -1;

    /* Validate train */
    for (i = 0; i < trainCount; i++) {
        if (trains[i].trainId == trainId) {
            tIdx = i;
            break;
        }
    }

    if (tIdx == -1) {
        sprintf(response, "\n[ERROR] Train %d does not exist!\n", trainId);
        return;
    }

    tr = &trains[tIdx];

    /* Validate class */
    for (j = 0; j < tr->classCount; j++) {
        if (tr->classes[j].classId == classId) {
            cIdx = j;
            break;
        }
    }

    if (cIdx == -1) {
        sprintf(response, "\n[ERROR] Class %d not available on this train!\n",
                classId);
        return;
    }

    cl = &tr->classes[cIdx];

    /* Validate tickets */
    if (numTickets <= 0 || numTickets > 6) {
        strcpy(response, "\n[ERROR] You can book 1 to 6 tickets at a time!\n");
        return;
    }

    /* Validate age */
    if (age <= 0 || age > 120) {
        strcpy(response, "\n[ERROR] Invalid age!\n");
        return;
    }

    /* Check availability */
    if (numTickets > cl->availableSeats) {
        sprintf(response,
                "\n[ERROR] Not enough seats!\n"
                "  Requested : %d\n"
                "  Available : %d\n"
                "  Try fewer tickets or another class.\n",
                numTickets, cl->availableSeats);
        return;
    }

    /* Check booking limit */
    if (bookingCount >= MAX_BOOKINGS) {
        strcpy(response, "\n[ERROR] Reservation system full!\n");
        return;
    }

    /* ---- PROCESS BOOKING ---- */
    cl->availableSeats -= numTickets;

    getTimestamp(ts, sizeof(ts));

    b = &bookings[bookingCount];
    b->pnr = nextPNR++;
    b->trainId = trainId;
    b->classId = classId;
    strcpy(b->passengerName, name);
    b->age = age;
    strcpy(b->gender, gender);
    b->numTickets = numTickets;
    b->totalFare = numTickets * cl->fare;
    strcpy(b->journeyDate, journeyDate);
    strcpy(b->status, "CONFIRMED");
    strcpy(b->bookingTime, ts);
    bookingCount++;

    sprintf(response,
            "\n================================================================\n"
            "            TICKET BOOKED SUCCESSFULLY!                        \n"
            "================================================================\n"
            "  PNR Number   : %d\n"
            "  Passenger    : %s (Age: %d, %s)\n"
            "  Train        : %d - %s\n"
            "  Route        : %s -> %s\n"
            "  Class        : %s\n"
            "  Journey Date : %s\n"
            "  Departure    : %s\n"
            "  Arrival      : %s\n"
            "  Tickets      : %d\n"
            "  Fare/Ticket  : Rs.%.0f\n"
            "  Total Fare   : Rs.%.0f\n"
            "  Status       : CONFIRMED\n"
            "  Booked At    : %s\n"
            "================================================================\n"
            "  ** Please note your PNR: %d **\n"
            "================================================================\n",
            b->pnr, b->passengerName, b->age, b->gender,
            tr->trainId, tr->trainName,
            tr->source, tr->destination,
            cl->className,
            b->journeyDate,
            tr->departure, tr->arrival,
            b->numTickets,
            cl->fare, b->totalFare,
            b->bookingTime,
            b->pnr);

    sprintf(logMsg, "BOOKED PNR#%d: %s - Train %d %s - %d tickets Rs.%.0f",
            b->pnr, name, trainId, cl->className,
            numTickets, b->totalFare);
    writeLog(NULL, 0, logMsg);

    saveDatabase();
}

/* ================== 5. CANCEL RESERVATION ================== */

void cancelReservation(int pnr, char *response) {
    int i, found;
    Train *tr;
    TrainClass *cl;
    char logMsg[256];

    found = -1;

    for (i = 0; i < bookingCount; i++) {
        if (bookings[i].pnr == pnr) {
            found = i;
            break;
        }
    }

    if (found == -1) {
        sprintf(response, "\n[ERROR] PNR %d not found!\n", pnr);
        return;
    }

    if (strcmp(bookings[found].status, "CANCELLED") == 0) {
        strcpy(response, "\n[ERROR] This booking is already cancelled!\n");
        return;
    }

    /* Restore seats */
    for (i = 0; i < trainCount; i++) {
        if (trains[i].trainId == bookings[found].trainId) {
            int j;
            for (j = 0; j < trains[i].classCount; j++) {
                if (trains[i].classes[j].classId == bookings[found].classId) {
                    trains[i].classes[j].availableSeats += bookings[found].numTickets;
                    break;
                }
            }
            tr = &trains[i];
            break;
        }
    }

    strcpy(bookings[found].status, "CANCELLED");

    sprintf(response,
            "\n================================================================\n"
            "          RESERVATION CANCELLED                                \n"
            "================================================================\n"
            "  PNR Number   : %d\n"
            "  Passenger    : %s\n"
            "  Train        : %d - %s\n"
            "  Tickets      : %d (restored)\n"
            "  Refund       : Rs.%.0f\n"
            "  Status       : CANCELLED\n"
            "================================================================\n",
            bookings[found].pnr,
            bookings[found].passengerName,
            bookings[found].trainId,
            tr->trainName,
            bookings[found].numTickets,
            bookings[found].totalFare);

    sprintf(logMsg, "CANCELLED PNR#%d: %s - Refund Rs.%.0f",
            pnr, bookings[found].passengerName,
            bookings[found].totalFare);
    writeLog(NULL, 0, logMsg);

    saveDatabase();
}

