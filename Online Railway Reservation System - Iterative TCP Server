/* ================== DATA STRUCTURES ================== */

typedef struct {
    int classId;
    char className[20];
    int totalSeats;
    int availableSeats;
    float fare;
} TrainClass;

typedef struct {
    int trainId;
    char trainName[60];
    char source[40];
    char destination[40];
    char departure[15];
    char arrival[15];
    char runDays[30];
    TrainClass classes[3];
    int classCount;
} Train;

typedef struct {
    int pnr;
    int trainId;
    int classId;
    char passengerName[100];
    int age;
    char gender[10];
    int numTickets;
    float totalFare;
    char journeyDate[20];
    char status[20];
    char bookingTime[30];
} Booking;

/* ================== GLOBAL VARIABLES ================== */

Train trains[MAX_TRAINS];
int trainCount = 0;

Booking bookings[MAX_BOOKINGS];
int bookingCount = 0;
int nextPNR = 100001;

/* ================== UTILITY: GET TIMESTAMP ================== */

void getTimestamp(char *buf, int size) {
    time_t now;
    struct tm *t;
    now = time(NULL);
    t = localtime(&now);
    strftime(buf, size, "%Y-%m-%d %H:%M:%S", t);
}

/* ================== LOGGING ================== */

void writeLog(const char *clientIP, int clientPort, const char *msg) {
    FILE *fp;
    char ts[64];
    getTimestamp(ts, sizeof(ts));

    fp = fopen(LOG_FILE, "a");
    if (fp != NULL) {
        if (clientIP != NULL) {
            fprintf(fp, "[%s] [%s:%d] %s\n", ts, clientIP, clientPort, msg);
        } else {
            fprintf(fp, "[%s] [SERVER] %s\n", ts, msg);
        }
        fclose(fp);
    }

    if (clientIP != NULL) {
        printf("[%s] [%s:%d] %s\n", ts, clientIP, clientPort, msg);
    } else {
        printf("[%s] [SERVER] %s\n", ts, msg);
    }
}

/* ================== SAVE DATABASE TO FILE ================== */

void saveDatabase() {
    FILE *fp;
    int i;

    fp = fopen(DB_FILE, "w");
    if (fp == NULL) return;

    fprintf(fp, "================================================================"
                "================================================================\n");
    fprintf(fp, "                    RAILWAY RESERVATION DATABASE\n");
    fprintf(fp, "================================================================"
                "================================================================\n");
    fprintf(fp, "%-10s %-8s %-5s %-15s %-5s %-8s %-4s %-10s %-12s %-12s %-20s\n",
            "PNR", "TrainID", "Cls", "Passenger", "Age", "Gender",
            "Qty", "Fare", "Journey", "Status", "BookedAt");
    fprintf(fp, "----------------------------------------------------------------"
                "----------------------------------------------------------------\n");

    for (i = 0; i < bookingCount; i++) {
        fprintf(fp, "%-10d %-8d %-5d %-15s %-5d %-8s %-4d %-10.0f %-12s %-12s %-20s\n",
                bookings[i].pnr,
                bookings[i].trainId,
                bookings[i].classId,
                bookings[i].passengerName,
                bookings[i].age,
                bookings[i].gender,
                bookings[i].numTickets,
                bookings[i].totalFare,
                bookings[i].journeyDate,
                bookings[i].status,
                bookings[i].bookingTime);
    }

    fprintf(fp, "================================================================"
                "================================================================\n");
    fprintf(fp, "Total Bookings: %d\n", bookingCount);
    fclose(fp);
}

