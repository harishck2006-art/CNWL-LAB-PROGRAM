/* ================== 1. SEARCH TRAINS ================== */

void searchTrains(char *src, char *dest, char *response) {
    char temp[512];
    int i, j, found;

    found = 0;
    strcpy(response, "\n");
    strcat(response, "================================================================\n");
    strcat(response, "                  TRAIN SEARCH RESULTS                          \n");
    strcat(response, "================================================================\n");

    for (i = 0; i < trainCount; i++) {
        if ((strcasecmp(trains[i].source, src) == 0) &&
            (strcasecmp(trains[i].destination, dest) == 0)) {

            found = 1;
            sprintf(temp, "\n  Train ID   : %d\n", trains[i].trainId);
            strcat(response, temp);
            sprintf(temp, "  Train Name : %s\n", trains[i].trainName);
            strcat(response, temp);
            sprintf(temp, "  Route      : %s -> %s\n",
                    trains[i].source, trains[i].destination);
            strcat(response, temp);
            sprintf(temp, "  Departure  : %s\n", trains[i].departure);
            strcat(response, temp);
            sprintf(temp, "  Arrival    : %s\n", trains[i].arrival);
            strcat(response, temp);
            sprintf(temp, "  Runs On    : %s\n", trains[i].runDays);
            strcat(response, temp);
            strcat(response, "  Classes & Fares:\n");

            for (j = 0; j < trains[i].classCount; j++) {
                sprintf(temp, "    [%d] %-12s | Seats: %3d/%3d | Rs.%.0f\n",
                        trains[i].classes[j].classId,
                        trains[i].classes[j].className,
                        trains[i].classes[j].availableSeats,
                        trains[i].classes[j].totalSeats,
                        trains[i].classes[j].fare);
                strcat(response, temp);
            }
            strcat(response, "  ------------------------------------------------------\n");
        }
    }

    if (!found) {
        strcat(response, "\n  No trains found from ");
        strcat(response, src);
        strcat(response, " to ");
        strcat(response, dest);
        strcat(response, "\n  Try: Chennai, Mumbai, Madurai, Coimbatore,\n");
        strcat(response, "       Trichy, Tirunelveli, Bangalore, Delhi\n");
    }
    strcat(response, "================================================================\n");
}

