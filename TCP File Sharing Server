#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <winsock2.h>

#pragma comment(lib, "ws2_32.lib")

#define PORT 8080
#define BUFFER_SIZE 4096

SOCKET sockfd;

void download_file(char *filename) {
    int command = 2;
    send(sockfd, (char*)&command, sizeof(int), 0);
    send(sockfd, filename, strlen(filename) + 1, 0);

    char status;
    recv(sockfd, &status, 1, 0);

    if (status == '1') {
        long fSize;
        recv(sockfd, (char*)&fSize, sizeof(long), 0);

        FILE *f = fopen(filename, "wb");
        if (f) {
            char buffer[BUFFER_SIZE];
            long totalReceived = 0;
            int bytesRead;

            printf("Downloading %s (%ld bytes)...\n", filename, fSize);
            while (totalReceived < fSize) {
                bytesRead = recv(sockfd, buffer, BUFFER_SIZE, 0);
                if (bytesRead <= 0) break;
                fwrite(buffer, 1, bytesRead, f);
                totalReceived += bytesRead;
            }
            fclose(f);
            printf("Download Complete!\n");
        } else {
            printf("Cannot create file locally.\n");
        }
    } else {
        printf("File Not Found on Server.\n");
    }
}

void list_files() {
    int command = 1;
    send(sockfd, (char*)&command, sizeof(int), 0);

    int count;
    recv(sockfd, (char*)&count, sizeof(int), 0);

    printf("\n--- Available Files (%d) ---\n", count);
    for (int i = 0; i < count; i++) {
        char filename[256];
        recv(sockfd, filename, 256, 0);
        printf("%d. %s\n", i + 1, filename);
    }
    printf("--------------------------\n");
}

int main() {
    WSADATA wsaData;
    struct sockaddr_in servaddr;
    int command;

    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        printf("Winsock Init Failed\n"); return 1;
    }

    sockfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockfd == INVALID_SOCKET) {
        printf("Socket Creation Failed\n"); return 1;
    }

    memset(&servaddr, 0, sizeof(servaddr));
    servaddr.sin_family = AF_INET;
    servaddr.sin_port = htons(PORT);
    servaddr.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sockfd, (struct sockaddr*)&servaddr, sizeof(servaddr)) < 0) {
        printf("Connection Failed. Is Server Running?\n"); return 1;
    }

    printf("Connected to File Server.\n");

    while (1) {
        printf("\n1. List Files  2. Download  3. Exit\nChoice: ");
        scanf("%d", &command);
        getchar(); // Clear newline

        if (command == 3) {
            int exitCmd = 3;
            send(sockfd, (char*)&exitCmd, sizeof(int), 0);
            break;
        } else if (command == 1) {
            list_files();
        } else if (command == 2) {
            char filename[256];
            printf("Enter filename: ");
            fgets(filename, 256, stdin);
            filename[strcspn(filename, "\n")] = 0; // Remove newline
            download_file(filename);
        }
    }

    closesocket(sockfd);
    WSACleanup();
    return 0;
}
