#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <winsock2.h>
#include <windows.h>

#pragma comment(lib, "ws2_32.lib")

#define PORT 8080
#define BUFFER_SIZE 4096
#define MAX_FILES 100

CRITICAL_SECTION print_lock;

// Client Handler Thread
DWORD WINAPI ClientHandler(LPVOID lpParam) {
    SOCKET clientSocket = (SOCKET)lpParam;
    char buffer[BUFFER_SIZE];
    char filename[256];
    int command;

    EnterCriticalSection(&print_lock);
    printf("New client connected.\n");
    LeaveCriticalSection(&print_lock);

    while (1) {
        // Receive Command (1=LIST, 2=GET, 3=EXIT)
        if (recv(clientSocket, (char*)&command, sizeof(int), 0) <= 0) {
            break; // Client disconnected
        }

        if (command == 1) {
            // LIST FILES
            WIN32_FIND_DATA findFileData;
            HANDLE hFind = FindFirstFile("*.*", &findFileData);
            int count = 0;
            char fileList[MAX_FILES][256];

            if (hFind != INVALID_HANDLE_VALUE) {
                do {
                    if (!(findFileData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
                        // Skip server exe itself
                        if (strcmp(findFileData.cFileName, "server.exe") != 0 && 
                            strcmp(findFileData.cFileName, "server.c") != 0) {
                            strcpy(fileList[count], findFileData.cFileName);
                            count++;
                        }
                    }
                } while (FindNextFile(hFind, &findFileData) && count < MAX_FILES);
                FindClose(hFind);
            }

            // Send Count
            send(clientSocket, (char*)&count, sizeof(int), 0);
            // Send Names
            for (int i = 0; i < count; i++) {
                send(clientSocket, fileList[i], strlen(fileList[i]) + 1, 0);
            }
        }
        else if (command == 2) {
            // GET FILE
            recv(clientSocket, filename, 256, 0);
            
            FILE *f = fopen(filename, "rb");
            if (f) {
                send(clientSocket, "1", 1, 0); // File Exists
                
                // Get File Size
                fseek(f, 0, SEEK_END);
                long fSize = ftell(f);
                fseek(f, 0, SEEK_SET);

                // Send Size
                send(clientSocket, (char*)&fSize, sizeof(long), 0);

                // Send Content
                int bytesRead;
                while ((bytesRead = fread(buffer, 1, BUFFER_SIZE, f)) > 0) {
                    send(clientSocket, buffer, bytesRead, 0);
                }
                fclose(f);
                
                EnterCriticalSection(&print_lock);
                printf("File %s sent successfully.\n", filename);
                LeaveCriticalSection(&print_lock);
            } else {
                send(clientSocket, "0", 1, 0); // File Not Found
            }
        }
        else if (command == 3) {
            // EXIT
            break;
        }
    }

    EnterCriticalSection(&print_lock);
    printf("Client disconnected.\n");
    LeaveCriticalSection(&print_lock);
    
    closesocket(clientSocket);
    return 0;
}

int main() {
    WSADATA wsaData;
    SOCKET serverSocket, clientSocket;
    struct sockaddr_in servaddr, cliaddr;
    int len = sizeof(cliaddr);

    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        printf("Winsock Init Failed\n"); return 1;
    }

    InitializeCriticalSection(&print_lock);

    serverSocket = socket(AF_INET, SOCK_STREAM, 0);
    if (serverSocket == INVALID_SOCKET) {
        printf("Socket Creation Failed\n"); return 1;
    }

    memset(&servaddr, 0, sizeof(servaddr));
    servaddr.sin_family = AF_INET;
    servaddr.sin_addr.s_addr = inet_addr("127.0.0.1");
    servaddr.sin_port = htons(PORT);

    if (bind(serverSocket, (const struct sockaddr*)&servaddr, sizeof(servaddr)) == SOCKET_ERROR) {
        printf("Bind Failed\n"); return 1;
    }

    listen(serverSocket, 5);
    printf("File Server Listening on Port %d...\n", PORT);
    printf("Keep some files in this folder to share.\n\n");

    while (1) {
        clientSocket = accept(serverSocket, (struct sockaddr*)&cliaddr, &len);
        if (clientSocket == INVALID_SOCKET) {
            printf("Accept Failed\n"); continue;
        }

        CreateThread(NULL, 0, ClientHandler, (LPVOID)clientSocket, 0, NULL);
    }

    closesocket(serverSocket);
    DeleteCriticalSection(&print_lock);
    WSACleanup();
    return 0;
}

