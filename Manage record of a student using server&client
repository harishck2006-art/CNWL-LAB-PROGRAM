#include "common.h"

void print_student(Student s) {
    printf("\n----------------------------------");
    printf("\nReg No: %d\nName: %s\nDept: %s\nSem: %d\nMarks: %.2f\nGrade: %s\nCGPA: %.2f", 
           s.reg_no, s.name, s.dept, s.semester, s.marks, s.grade, s.cgpa);
}

int main() {
    int sock;
    struct sockaddr_in serv_addr;
    sock = socket(AF_INET, SOCK_STREAM, 0);

    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &serv_addr.sin_addr);

    if (connect(sock, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        printf("Connection failed!\n");
        return -1;
    }

    int choice;
    while (1) {
        printf("\n\n--- STUDENT SYSTEM ---\n1. Add\n2. Search\n3. Display All\n4. Topper\n5. Exit\nChoice: ");
        scanf("%d", &choice);

        Request req = {0};
        Response res = {0};
        req.cmd = (Command)choice;

        if (choice == 1) {
            printf("Enter RegNo Name Dept Sem Marks Grade CGPA: ");
            scanf("%d %s %s %d %f %s %f", &req.data.reg_no, req.data.name, req.data.dept, 
                  &req.data.semester, &req.data.marks, req.data.grade, &req.data.cgpa);
        } else if (choice == 2) {
            printf("Enter RegNo to Search: ");
            scanf("%d", &req.target_reg_no);
        } else if (choice == 5) {
            send(sock, &req, sizeof(Request), 0);
            break;
        }

        send(sock, &req, sizeof(Request), 0);

        if (choice == 3) {
            while (recv(sock, &res, sizeof(Response), 0) > 0 && res.count != 0) {
                print_student(res.data);
            }
        } else {
            recv(sock, &res, sizeof(Response), 0);
            if (res.success) {
                if (choice == 1) printf("%s", res.message);
                else print_student(res.data);
            } else {
                printf("Error/Not Found!");
            }
        }
    }
    close(sock);
    return 0;
}
