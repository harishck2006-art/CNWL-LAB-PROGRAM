        printf("Source IP : %s\n", srcipbin);
        printf("Destination IP : %s\n", dstipbin);
        printf("Source MAC : %s\n", srcmacbin);
        printf("Destination MAC : %s\n", dstmacbin);
        printf("Frame Data : %s\n", frame);
