#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define SIZE 10
#define MAX_MSG 500
#define MAX_BINARY 10000

struct Hash
{
    char url[50];
    char ip[20];
    char mac[20];
    int used;
};

struct Hash hashtable[SIZE];

int hashfunction(char *s)
{
    int sum = 0;
    int i;
    for (i = 0; s[i] != '\0'; i++)
    {
        sum = sum + s[i];
    }
    return sum % SIZE;
}

void numberToBinary(int n, char *bin)
{
    int i;
    for (i = 7; i >= 0; i--)
    {
        bin[i] = (n % 2) + '0';
        n = n / 2;
    }
    bin[8] = '\0';
}

void ipToBinary(char *ip, char *bin)
{
    int a, b, c, d;
    char temp[9];
    sscanf(ip, "%d.%d.%d.%d", &a, &b, &c, &d);
    bin[0] = '\0';
    numberToBinary(a, temp); strcat(bin, temp);
    numberToBinary(b, temp); strcat(bin, temp);
    numberToBinary(c, temp); strcat(bin, temp);
    numberToBinary(d, temp); strcat(bin, temp);
}

void macToBinary(char *mac, char *bin)
{
    int a, b, c, d, e, f;
    char temp[9];
    sscanf(mac, "%x:%x:%x:%x:%x:%x", &a, &b, &c, &d, &e, &f);
    bin[0] = '\0';
    numberToBinary(a, temp); strcat(bin, temp);
    numberToBinary(b, temp); strcat(bin, temp);
    numberToBinary(c, temp); strcat(bin, temp);
    numberToBinary(d, temp); strcat(bin, temp);
    numberToBinary(e, temp); strcat(bin, temp);
    numberToBinary(f, temp); strcat(bin, temp);
}

void messageToBinary(char *msg, char *bin)
{
    int i;
    char temp[9];
    bin[0] = '\0';
    for (i = 0; msg[i] != '\0'; i++)
    {
        numberToBinary((unsigned char)msg[i], temp);
        strcat(bin, temp);
    }
}

void insert(char *u, char *i, char *m)
{
    int position = hashfunction(u);
    int start = position;

    while (hashtable[position].used == 1)
    {
        if (strcmp(hashtable[position].url, u) == 0)
        {
            strcpy(hashtable[position].ip, i);
            strcpy(hashtable[position].mac, m);
            return;
        }
        position = (position + 1) % SIZE;
        if (position == start)
            return;
    }

    strcpy(hashtable[position].url, u);
    strcpy(hashtable[position].ip, i);
    strcpy(hashtable[position].mac, m);
    hashtable[position].used = 1;
}

int search(char *u, char *i, char *m)
{
    int position = hashfunction(u);
    int start = position;

    while (hashtable[position].used == 1)
    {
        if (strcmp(hashtable[position].url, u) == 0)
        {
            strcpy(i, hashtable[position].ip);
            strcpy(m, hashtable[position].mac);
            return 1;
        }
        position = (position + 1) % SIZE;
        if (position == start)
            break;
    }
    return 0;
}

void generateIp(char *ip)
{
    sprintf(ip, "172.16.%d.%d", rand() % 254 + 1, rand() % 254 + 1);
}

void generateMac(char *mac)
{
    sprintf(mac, "%02X:%02X:%02X:%02X:%02X:%02X",
            rand() % 256, rand() % 256, rand() % 256,
            rand() % 256, rand() % 256, rand() % 256);
}

void printTable()
{
    int i;
    printf("      4-LAYER NETWORK SIMULATOR (in binary)\n");
    printf("***************************************************\n");
    printf("---------------------------------------------------\n");
    printf(" HASH TABLE (URL -> IP -> MAC)\n");
    printf("---------------------------------------------------\n");
    for (i = 0; i < SIZE; i++)
    {
        if (hashtable[i].used == 1)
        {
            printf(" %d : %s | %s | %s\n", i + 1, hashtable[i].url, hashtable[i].ip, hashtable[i].mac);
        }
    }
    printf("---------------------------------------------------\n");
}

void getOrCreate(char *url, char *ip, char *mac)
{
    if (search(url, ip, mac) == 0)
    {
        generateIp(ip);
        generateMac(mac);
        insert(url, ip, mac);
    }
}

