#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 9445
#define BUF 100

struct Frame {
    int seq;
    int checksum;
    char data[BUF];
};

struct Ack {
    int ack;
};

int checksum(char *data, int seq) {
    int sum = seq;
    int i;
    for (i = 0; data[i] != '\0'; i++) sum += data[i];
    return sum;
}

int main() {
    int serverSock, clientSock;
    struct sockaddr_in server, client;
    socklen_t len;
    int expected = 0;
    int lostFrame, errorFrame;

    printf("Enter frame number to simulate LOSS (-1 for none): ");
    scanf("%d", &lostFrame);

    printf("Enter frame number to simulate ERROR (-1 for none): ");
    scanf("%d", &errorFrame);

    serverSock = socket(AF_INET, SOCK_STREAM, 0);
    if (serverSock < 0) { perror("Socket"); exit(1); }

    int opt = 1;
    setsockopt(serverSock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    server.sin_addr.s_addr = INADDR_ANY;

    if (bind(serverSock, (struct sockaddr *)&server, sizeof(server)) < 0) {
        perror("Bind");
        exit(1);
    }

    listen(serverSock, 5);
    printf("\nReceiver waiting...\n");

    len = sizeof(client);
    clientSock = accept(serverSock, (struct sockaddr *)&client, &len);
    if (clientSock < 0) { perror("Accept"); exit(1); }
    printf("Sender connected.\n\n");

    while (1) {
        struct Frame f;
        struct Ack ack;
        int n = recv(clientSock, &f, sizeof(f), 0);

        if (n <= 0) break;

        if (lostFrame != -1 && f.seq == lostFrame) {
            printf("* Frame %d LOST *\n", f.seq);
            lostFrame = -1;
            continue;
        }

        if (errorFrame != -1 && f.seq == errorFrame) {
            printf("* Frame %d contains ERROR *\n", f.seq);
            f.checksum += 999;
            errorFrame = -1;
        }

        if (f.checksum != checksum(f.data, f.seq)) {
            printf("Checksum ERROR detected in frame %d\n", f.seq);
            printf("Frame discarded.\n");
            ack.ack = expected - 1;
            send(clientSock, &ack, sizeof(ack), 0);
            printf("Receiver -> ACK %d\n\n", ack.ack);
            continue;
        }

        if (f.seq == expected) {
            printf("Receiver <- Frame %d received: %s\n", f.seq, f.data);
            ack.ack = f.seq;
            expected++;
            send(clientSock, &ack, sizeof(ack), 0);
            printf("Receiver -> ACK %d\n\n", ack.ack);
        } else {
            printf("Out-of-order frame %d received. Expected = %d (Discarded).\n", f.seq, expected);
            ack.ack = expected - 1;
            send(clientSock, &ack, sizeof(ack), 0);
            printf("Receiver -> ACK %d\n\n", ack.ack);
        }
    }

    close(clientSock);
    close(serverSock);
    return 0;
}

