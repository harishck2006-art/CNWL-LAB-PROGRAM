#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 9090
#define BUFFER_SIZE 4096
#define SERVER_IP "127.0.0.1"

void displayMenu() {
    printf("\n");
    printf("==================================================\n");
    printf("      HOTEL ROOM RESERVATION SYSTEM               \n");
    printf("==================================================\n");
    printf("  1. View Room Availability\n");
    printf("  2. Book a Room\n");
    printf("  3. Cancel Reservation\n");
    printf("  4. Check Booking Details\n");
    printf("  5. Exit\n");
    printf("==================================================\n");
    printf("  Enter your choice: ");
}

int main() {
    int sockFd;
    struct sockaddr_in serverAddr;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    int choice, n;
    int roomId, nights, bid;
    char guestName[100], checkIn[20], checkOut[20];

    sockFd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockFd < 0) {
        perror("Socket failed");
        exit(1);
    }

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_port = htons(PORT);
    inet_pton(AF_INET, SERVER_IP, &serverAddr.sin_addr);

    if (connect(sockFd, (struct sockaddr *)&serverAddr,
                sizeof(serverAddr)) < 0) {
        perror("Connection failed! Is server running?");
        close(sockFd);
        exit(1);
    }

    printf("\n==================================================\n");
    printf("   Connected to Hotel Reservation Server!         \n");
    printf("==================================================\n");

    while (1) {
        displayMenu();
        scanf("%d", &choice);

        memset(buffer, 0, BUFFER_SIZE);
        memset(response, 0, BUFFER_SIZE);

        switch (choice) {
            case 1:
                sprintf(buffer, "1");
                break;

            case 2:
                printf("\n  --- ROOM BOOKING ---\n");
                printf("  Enter Room Number (101-110): ");
                scanf("%d", &roomId);
                printf("  Enter Guest Name: ");
                scanf("%s", guestName);
                printf("  Enter Check-In Date (DD/MM/YYYY): ");
                scanf("%s", checkIn);
                printf("  Enter Check-Out Date (DD/MM/YYYY): ");
                scanf("%s", checkOut);
                printf("  Enter Number of Nights: ");
                scanf("%d", &nights);
                sprintf(buffer, "2 %d %s %s %s %d",
                        roomId, guestName, checkIn, checkOut, nights);
                break;

            case 3:
                printf("\n  Enter Booking ID to cancel: ");
                scanf("%d", &bid);
                sprintf(buffer, "3 %d", bid);
                break;

            case 4:
                printf("\n  Enter Booking ID to view: ");
                scanf("%d", &bid);
                sprintf(buffer, "4 %d", bid);
                break;

            case 5:
                sprintf(buffer, "5");
                write(sockFd, buffer, strlen(buffer));
                memset(response, 0, BUFFER_SIZE);
                read(sockFd, response, BUFFER_SIZE - 1);
                printf("%s", response);
                printf("\nGoodbye!\n\n");
                close(sockFd);
                return 0;

            default:
                printf("\n[ERROR] Invalid choice!\n");
                continue;
        }

        /* Send request */
        write(sockFd, buffer, strlen(buffer));

        /* Receive response */
        memset(response, 0, BUFFER_SIZE);
        n = read(sockFd, response, BUFFER_SIZE - 1);
        if (n <= 0) {
            printf("\n[ERROR] Server disconnected!\n");
            break;
        }
        response[n] = '\0';
        printf("%s", response);
    }

    close(sockFd);
    return 0;
}
