#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define SIZE 20

struct Frame
{
    int seq;
    char data[SIZE];
    int checksum;
};

int checksum(char data[])
{
    int sum = 0;
    int i;
    for(i = 0; data[i] != '\0'; i++)
        sum = sum + data[i];
    return sum;
}

int main()
{
    int sock, newSock;
    struct sockaddr_in receiver;
    struct Frame frame;

    char message[200] = "";
    char ack[20];

    int expected = 0;
    int result;

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) { perror("Socket failed"); exit(1); }

    int opt = 1;
    setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    receiver.sin_family = AF_INET;
    receiver.sin_port = htons(9000);
    receiver.sin_addr.s_addr = INADDR_ANY;

    if (bind(sock, (struct sockaddr *)&receiver, sizeof(receiver)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }

    listen(sock, 1);
    printf("Receiver waiting on port 9000...\n");

    newSock = accept(sock, NULL, NULL);
    printf("Sender connected.\n\n");

    while(1)
    {
        result = recv(newSock, &frame, sizeof(frame), 0);

        if(result <= 0)
        {
            printf("\nTransmission complete. Closing sockets.\n");
            break;
        }

        printf("\n-------------------------\n");
        printf("Frame received\n");
        printf("Sequence Number: %d (Expected: %d)\n", frame.seq, expected);
        printf("Data: %s\n", frame.data);

        /* Check for Checksum Error */
        if(checksum(frame.data) != frame.checksum)
        {
            printf("Frame has ERROR!\n");
            printf("Frame discarded.\n");
            // Do NOT send ACK. Let the sender timeout and retry.
            continue;
        }

        /* Check sequence alignment */
        if(frame.seq == expected)
        {
            printf("Correct frame received.\n");
            strcat(message, frame.data);

            // ACK specifies the next frame expected (1-expected)
            sprintf(ack, "%d", 1 - expected);
            send(newSock, ack, strlen(ack) + 1, 0);
            printf("ACK %s sent.\n", ack);

            expected = 1 - expected; // Toggle expected state (0->1 or 1->0)
            printf("Message so far: %s\n", message);
        }
        else
        {
            /* Duplicate frame safety handler */
            printf("Duplicate frame received.\n");
            printf("Frame not added again.\n");

            // Resend ACK telling sender what sequence we are waiting for now
            sprintf(ack, "%d", expected);
            send(newSock, ack, strlen(ack) + 1, 0);
            printf("ACK %s sent again.\n", ack);
        }
    }

    close(newSock);
    close(sock);
    return 0;
}
