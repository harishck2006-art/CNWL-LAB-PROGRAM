#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/time.h>

#define SIZE 20

struct Frame
{
    int seq;
    char data[SIZE];
    int checksum;
};

struct Node
{
    struct Frame frame;
    struct Node *next;
};

struct Queue
{
    struct Node *front;
    struct Node *rear;
};

void initQueue(struct Queue *q)
{
    q->front = NULL;
    q->rear = NULL;
}

void enqueue(struct Queue *q, struct Frame f)
{
    struct Node *newNode;
    newNode = (struct Node *)malloc(sizeof(struct Node));
    newNode->frame = f;
    newNode->next = NULL;

    if(q->rear == NULL)
    {
        q->front = newNode;
        q->rear = newNode;
    }
    else
    {
        q->rear->next = newNode;
        q->rear = newNode;
    }
}

struct Frame dequeue(struct Queue *q)
{
    struct Frame f;
    struct Node *temp;

    temp = q->front;
    f = temp->frame;

    q->front = q->front->next;

    if(q->front == NULL)
        q->rear = NULL;

    free(temp);

    return f;
}

int isEmpty(struct Queue *q)
{
    return q->front == NULL;
}

int checksum(char data[])
{
    int sum = 0;
    int i;
    for(i = 0; data[i] != '\0'; i++)
        sum = sum + data[i];
    return sum;
}

int main()
{
    int sock;
    struct sockaddr_in receiver;
    struct Frame frame;
    struct Queue q;

    char message[100];
    char ack[20];

    int i;
    int seq = 0;
    int choice;
    int specialFrame;
    int result;

    initQueue(&q);

    sock = socket(AF_INET, SOCK_STREAM, 0);

    receiver.sin_family = AF_INET;
    receiver.sin_port = htons(9000);
    receiver.sin_addr.s_addr = inet_addr("127.0.0.1");

if(connect(sock, (struct sockaddr *)&receiver, sizeof(receiver)) < 0) {
        perror("Connection failed");
        exit(1);
    }
    printf("Connected to receiver.\n");

    printf("Enter message: ");
    fgets(message, sizeof(message), stdin);
    message[strcspn(message, "\n")] = '\0';

    for(i = 0; i < strlen(message); i = i + SIZE - 1)
    {
        frame.seq = seq;
        strncpy(frame.data, message + i, SIZE - 1);
        frame.data[SIZE - 1] = '\0';
        frame.checksum = checksum(frame.data);
        enqueue(&q, frame);
        seq = 1 - seq;
    }

    printf("\nMessage divided into frames.\n");
    printf("\n1. Timeout\n2. Frame Lost\n3. Frame Error\n4. Normal Transmission\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    specialFrame = -1;
    if(choice == 2 || choice == 3)
    {
        printf("Enter frame number (1-based index): ");
        scanf("%d", &specialFrame);
        specialFrame--;
    }

    // Set socket receive timeout to 3 seconds for Stop-and-Wait
    struct timeval tv;
    tv.tv_sec = 3;
    tv.tv_usec = 0;
    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));

    i = 0;
    while(!isEmpty(&q))
    {
        // Peek at front frame without dequeuing immediately
        frame = q.front->frame;

        printf("\n-------------------------\n");
        printf("Sending Frame %d\n", i + 1);
        printf("Sequence Number: %d\n", frame.seq);
        printf("Data: %s\n", frame.data);

        if(choice == 2 && i == specialFrame)
        {
            printf("Frame is LOST! (Simulated by dropping packet)\n");
            specialFrame = -1;
            // Intentionally skip sending to receiver
        }
        else
        {
            if(choice == 3 && i == specialFrame)
            {
                printf("Frame has ERROR! (Simulated Checksum Mismatch)\n");
                frame.checksum += 10; // Corrupt checksum value
                specialFrame = -1;
            }
            send(sock, &frame, sizeof(frame), 0);
            printf("Frame sent.\n");
        }

        // Wait for single character ACK response
        result = recv(sock, ack, sizeof(ack) - 1, 0);

        if(result <= 0) // Timeout triggers if no response within 3s
        {
            printf("\n** TIMEOUT! No ACK received for Frame %d. **\n", i + 1);
            printf("Resending Frame %d...\n", i + 1);

            // Retransmit fresh unmodified copy
            frame = q.front->frame;
            send(sock, &frame, sizeof(frame), 0);

            result = recv(sock, ack, sizeof(ack) - 1, 0);
            if(result > 0)
            {
                ack[result] = '\0';
                printf("ACK received after timeout retry: %s\n", ack);
                dequeue(&q); // Clear element only on success
                i++;
            }
        }
        else
        {
            ack[result] = '\0';
            printf("ACK received: %s\n", ack);
            dequeue(&q); // Success, shift pointer
            i++;
        }
    }

    printf("\n-------------------------\n");
    printf("All frames sent successfully.\n");
    close(sock);
    return 0;
}

